{
  "name": "cashier-front",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nuxt build --dotenv .env.production",
    "postbuild": "node ./scripts/purge-cf-cache.mjs",
    "cf:purge": "node ./scripts/purge-cf-cache.mjs",
    "dev": "node ./node_modules/nuxt/bin/nuxt.mjs dev --host 0.0.0.0 --port 3002",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "generate:contracts": "python ../scripts/generate_contracts.py",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^2.18.0",
    "@pinia/nuxt": "^0.5.5",
    "@vueuse/nuxt": "^11.1.0",
    "dayjs": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "nuxt": "^3.13.2",
    "pinia": "^2.2.4",
    "vue": "^3.5.11"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.5.7",
    "@nuxt/typescript-build": "^3.0.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
}
